# Telegram Bot Configuration
# Get this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Local Telegram API Configuration
# Go to https://my.telegram.org and get these from "API development tools"
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# Telegram API Server Port (default: 8081)
TELEGRAM_API_PORT=8081

# Application Environment (Development/Production)
ASPNETCORE_ENVIRONMENT=Production

# Application URL
ASPNETCORE_URLS=http://+:8080

# Shared directory for file exchange between services
# This should match the mount point in docker-compose.yml
SHARED_DIRECTORY=/shared

# Temporary files directory
TEMP_FILES_PATH=/tmp/audio_processing

# Maximum file size in MB (2048 MB = 2 GB for local API)
MAX_FILE_SIZE_MB=2048
