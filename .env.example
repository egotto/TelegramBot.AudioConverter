# Local Telegram API Configuration
# Go to https://my.telegram.org and get these from "API development tools"
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE
TELEGRAM_LOCAL=1
TELEGRAM_STAT=1
TELEGRAM_API_PORT=8081

# Telegram Bot Configuration
# Get this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_API_BASE_URL=http://telegram-api:8081

# PostgreSQL Configuration
POSTGRES_DB=telegram_audio_bot
POSTGRES_USER=telegram_audio_bot
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
SHARED_DIRECTORY=/var/lib/telegram-bot-api
TEMP_FILES_PATH=/app/temp
# Maximum file size in MB (2048 MB = 2 GB for local API)
MAX_FILE_SIZE_MB=2048

# yt-dlp download limits and runtime configuration
YT_DLP_EXECUTABLE_PATH=yt-dlp
YT_DLP_FFMPEG_LOCATION=/usr/bin
YT_DLP_MAX_CONCURRENT_DOWNLOADS=2
# 0 means no playlist item limit
YT_DLP_MAX_PLAYLIST_ITEMS=0
YT_DLP_PROGRESS_UPDATE_INTERVAL_SECONDS=5
