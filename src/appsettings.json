{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TelegramAudioBot": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "HistoryCleanup": {
    "IntervalHours": 4,
    "RetentionDays": 7
  },
  "TEMP_FILES_PATH": "/tmp/audio_processing",
  "SHARED_DIRECTORY": "/var/lib/telegram-bot-api",
  "MAX_FILE_SIZE_MB": 2048,
  "TELEGRAM_BOT_TOKEN": "",
  "TELEGRAM_API_BASE_URL": ""
}
