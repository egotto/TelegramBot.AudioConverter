{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TelegramAudioBot": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "HistoryCleanup": {
    "IntervalHours": 4,
    "RetentionDays": 7
  },
  "TEMP_FILES_PATH": "/tmp/audio_processing",
  "SHARED_DIRECTORY": "/var/lib/telegram-bot-api",
  "MAX_FILE_SIZE_MB": 2048,
  "YtDlp": {
    "ExecutablePath": "yt-dlp",
    "FfmpegLocation": "/usr/bin",
    "MaxConcurrentDownloads": 2,
    "MaxPlaylistItems": 0,
    "ProgressUpdateIntervalSeconds": 5
  },
  "UpdateProcessing": {
    "WorkerCount": 4,
    "QueueCapacity": 100
  },
  "TELEGRAM_BOT_TOKEN": "",
  "TELEGRAM_API_BASE_URL": ""
}
